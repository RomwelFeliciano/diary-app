{
  "name": "diary-app",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack MERN diary application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev -w server\" \"npm run start -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run start -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "typescript": "~4.9.5"
  }
}
