# Port the Express server listens on
# NOTE: avoid 5000 on macOS - Control Center's AirPlay Receiver squats on it
# and will silently answer requests instead of your server (causes confusing
# CORS/403 errors). Disable AirPlay Receiver in System Settings, or just use
# a different port, as below.
PORT=5001

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/diary-app

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret

# How long issued JWTs stay valid
JWT_EXPIRES_IN=3d

# Origin allowed to call this API (the client's URL)
CLIENT_ORIGIN=http://localhost:3000

NODE_ENV=development
